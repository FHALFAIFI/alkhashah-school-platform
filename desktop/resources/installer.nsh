; Father's App installer hooks (generated from resources/stop-owned-postgres.ps1 — keep in sync;
; a unit test checks the embedded command decodes to that file).
;
; Before an upgrade or uninstall replaces files, PostgreSQL servers started by a Father's App
; installation are stopped cleanly with that installation's own pg_ctl (fast, wait). Processes
; are matched by executable location, so an unrelated PostgreSQL on the machine is never
; touched, and nothing is force-killed. A running FathersApp.exe is handled by
; electron-builder's standard "application is running" check (graceful WM_CLOSE first).
!macro stopOwnedPostgres
  nsExec::ExecToLog '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand '
  Pop $0
!macroend

!macro customInit
  !insertmacro stopOwnedPostgres
!macroend

!macro customUnInit
  !insertmacro stopOwnedPostgres
!macroend
