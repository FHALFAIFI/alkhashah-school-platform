{
  "name": "fathers-app-desktop",
  "productName": "Father's App",
  "version": "2.6.0",
  "private": true,
  "description": "منصة الإدارة المدرسية المتكاملة — نسخة ويندوز المكتبية دون اتصال",
  "author": "مجمع الخشعة التعليمي للبنين",
  "main": "main/main.js",
  "scripts": {
    "fetch-binaries": "node scripts/fetch-binaries.mjs",
