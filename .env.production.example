# مثال بيئة الإنتاج — انسخه إلى .env.production واملأ الأسرار محلياً. لا تُودع الأسرار في Git.
#   cp .env.production.example .env.production && nano .env.production
# ثم:
#   docker compose -f compose.production.yml --env-file .env.production -p madrasa-prod up -d --build

# ————— قاعدة البيانات (غير منشورة — داخلية فقط) —————
POSTGRES_USER=madrasa
# ولّد كلمة قوية: openssl rand -base64 24
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=madrasa

# ————— التطبيق —————
# ولّد: openssl rand -hex 32
SESSION_SECRET=change-me-64-hex-chars
# منفذ المضيف المحلي (يُربط على 127.0.0.1 فقط)
APP_PORT=3080
# عنوان الوصول عبر Tailscale Serve (يُضبط بعد إعداد Tailscale على المضيف)
APP_URL=https://school-server.your-tailnet.ts.net
# الأصول الموثوقة لإجراءات الخادم خلف HTTPS (فواصل). النمط الافتراضي يسمح بأي جهاز تايل نت.
TRUSTED_ORIGINS=*.ts.net
# إصدار التطبيق (يظهر في الإعدارة وبيانات الملاحظات)
APP_VERSION=0.1.0

# ————— النسخ الاحتياطي المشفّر (إلزامي للنسخ) —————
# ولّد وخزّن خارج القبو وخارج الأرشيف: openssl rand -base64 32
BACKUP_PASSPHRASE=change-me-backup-passphrase
# وجهة نسخ خارجية اختيارية (قرص خارجي / عقدة تايل نت ثانية)
# BACKUP_OFFSITE_DIR=/mnt/offsite/madrasa

# ————— الذكاء الاصطناعي المحلي (اختياري — المنصة تعمل كاملة بدونه) —————
# Mac Apple Silicon: Ollama أصلي على المضيف (تسريع Metal) — الحاوية تصل عبر host-gateway
# Ubuntu: Ollama أصلي على المضيف أو خدمة حاوية (انظر docs/DOCKER_HOMELAB_DEPLOYMENT.md)
