# انسخ هذا الملف إلى ‎.env‎ وعبّئ القيم — لا تضع القيم الحقيقية في Git
# Copy to .env and fill in values. Never commit real values.

DATABASE_URL=postgresql://madrasa:madrasa_dev@localhost:5544/madrasa
POSTGRES_USER=madrasa
POSTGRES_PASSWORD=madrasa_dev
POSTGRES_DB=madrasa
POSTGRES_PORT=5544

# 64+ random hex chars: openssl rand -hex 32
SESSION_SECRET=

APP_PORT=3080
APP_URL=http://localhost:3080

# Private storage & backups (absolute or repo-relative paths)
STORAGE_DIR=./storage
BACKUP_DIR=./backups

# Backup encryption passphrase (required for backups): openssl rand -hex 24
BACKUP_PASSPHRASE=

# Optional integrations — all disabled by default; each can be enabled independently
# الذكاء الاصطناعي المحلي (معطل افتراضياً — التطبيق يعمل كاملاً بدونه)
AI_ENABLED=false
AI_PROVIDER=ollama            # ollama | anythingllm
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=qwen3-vl:8b
ANYTHINGLLM_BASE_URL=
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_WORKSPACE=school

# تكامل Microsoft 365 (مسودات بريد فقط — لا إرسال تلقائي؛ يتطلب تسجيل تطبيق لدى المؤسسة)
M365_ENABLED=false
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_SENDER_UPN=

# سياسة الاحتفاظ بالنسخ ووجهة خارج الجهاز (اختياري: مجلد قرص خارجي أو عقدة أخرى)
BACKUP_DAILY_RETENTION=14
BACKUP_WEEKLY_RETENTION=8
BACKUP_OFFSITE_DIR=
